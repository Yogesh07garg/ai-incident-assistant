GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=your-username/your-repo-name
# Single-account dashboard login (see README.md)
LOGIN_USERNAME=admin
# Generate with: python assistant-service/auth.py
LOGIN_PASSWORD_HASH=
# The account setup command also generates SESSION_SECRET automatically.
SESSION_SECRET=
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
